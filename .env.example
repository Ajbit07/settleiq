# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_DB=settleiq
POSTGRES_USER=settleiq
POSTGRES_PASSWORD=change-me-in-any-real-environment
API_PORT=8080   # change if something already holds this port
ML_PORT=8000    # change if something already holds this port

# ── Optional: API-key auth ───────────────────────────────────────────────────
# Format: key:merchant,merchant|key2:*   ("*" means every merchant)
# Unset means the API runs OPEN and reports that on /api/v1/auth/status.
SETTLEIQ_API_KEYS=
SETTLEIQ_RATE_LIMIT_PER_MIN=600

# ── Optional: LLM planner for the exception agent ────────────────────────────
# The planner picks WHICH read-only lookup the agent runs next. It can neither
# compute an amount nor reach the ledger; every rupee is re-derived afterwards
# by the deterministic policy engine.
#
# Default is a LOCAL model via Ollama, so no API key and no credential exists,
# and the merchant's payment data never leaves the machine.
#
#   winget install Ollama.Ollama      (or https://ollama.com/download)
#   ollama pull llama3.2
#   ollama serve
#
# BASE_URL is deliberately left unset. The two runtimes need different hosts and
# .env is shared by both: inside the API container "localhost" is the container,
# so compose defaults it to host.docker.internal, while the engine run directly
# on the host defaults it to localhost. Setting it here would force one value on
# both and silently break whichever one it is wrong for.
SETTLEIQ_LLM_PROVIDER=ollama
# SETTLEIQ_LLM_BASE_URL=http://localhost:11434
SETTLEIQ_LLM_MODEL=phi4-mini:latest
SETTLEIQ_LLM_TIMEOUT_MS=90000
# Planner calls per run; the rest fall back to the deterministic planner.
SETTLEIQ_LLM_MAX_CALLS=12

# Only for the hosted provider. Leave empty for Ollama. Never commit a real key.
SETTLEIQ_LLM_API_KEY=
