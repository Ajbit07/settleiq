<configuration>
  <!-- Human-readable locally, structured JSON everywhere else. Log
       aggregation needs fields, not prose, and a finance service needs its
       run ids and merchant ids queryable. -->
  <springProfile name="local,test">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="STDOUT"/></root>
  </springProfile>

  <springProfile name="!local &amp; !test">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>run_id</includeMdcKeyName>
        <includeMdcKeyName>merchant_id</includeMdcKeyName>
        <customFields>{"service":"settleiq-api"}</customFields>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</configuration>
